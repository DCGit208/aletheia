{
  "name": "aletheia",
  "version": "0.1.0",
  "private": true,
  "description": "Aletheia — the digital platform of Aletheia World.",
  "scripts": {
    "dev": "next dev --port 43147 --hostname 0.0.0.0",
    "build": "next build",
    "build:hosting": "FIREBASE_HOSTING=1 next build",
    "deploy:hosting": "npm run build:hosting && npx -y firebase-tools@latest deploy --only hosting",
